<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALPHABEAR QUANT TERMINAL</title>
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <style>
        body {
            background-color: #080b11;
            color: #00f2fe;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #1f293d;
            padding-bottom: 10px;
        }
        .price-card {
            font-size: 32px;
            font-weight: bold;
            color: #ffffff;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 3fr;
            gap: 20px;
            margin-top: 20px;
        }
        .panel {
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 8px;
            padding: 20px;
        }
        .stat-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
        }
        .btn-run {
            background: #00f2fe;
            color: #000;
            border: none;
            padding: 12px 24px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            margin-top: 15px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2>ALPHABEAR QUANT TERMINAL</h2>
        <div>STATUS: <span style="color: #00ff88;">AI ENGINE ACTIVE</span></div>
    </div>

    <div class="stats-grid">
        <!-- القائمة الجانبية للأرقام -->
        <div class="panel">
            <div style="color: #94a3b8; font-size: 12px;">BTC / USDT</div>
            <div class="price-card" id="current-price">$68,734.21</div>
            <hr style="border-color: #1e293b; margin: 15px 0;">
            
            <div class="stat-row"><span>Mean Expected:</span><strong id="p-mean" style="color:#fff;">-</strong></div>
            <div class="stat-row"><span>95% Percentile (Bull):</span><strong id="p-95" style="color:#00ff88;">-</strong></div>
            <div class="stat-row"><span>75% Percentile:</span><strong id="p-75" style="color:#00f2fe;">-</strong></div>
            <div class="stat-row"><span>50% Median:</span><strong id="p-50" style="color:#ffcc00;">-</strong></div>
            <div class="stat-row"><span>5% Percentile (Bear):</span><strong id="p-5" style="color:#ff0055;">-</strong></div>

            <button class="btn-run" onclick="fetchSimulation()">RUN MONTE CARLO (10,000 PATHS)</button>
        </div>

        <!-- الشارت التفاعلي -->
        <div class="panel">
            <div id="chart-container" style="width:100%; height:500px;"></div>
        </div>
    </div>

    <script>
        const API_URL = "https://quant-monte-carlo-engine.onrender.com/simulate";

        async function fetchSimulation() {
            try {
                const response = await fetch(API_URL);
                const data = await response.json();

                // تحديث القيم في الواجهة
                document.getElementById('current-price').innerText = `$${data.current_price.toLocaleString()}`;
                document.getElementById('p-mean').innerText = `$${Math.round(data.mean_expected_price).toLocaleString()}`;
                document.getElementById('p-95').innerText = `$${Math.round(data.percentile_95).toLocaleString()}`;
                document.getElementById('p-75').innerText = `$${Math.round(data.percentile_75).toLocaleString()}`;
                document.getElementById('p-50').innerText = `$${Math.round(data.percentile_50).toLocaleString()}`;
                document.getElementById('p-5').innerText = `$${Math.round(data.percentile_5).toLocaleString()}`;

                // رسم الشارت التفاعلي
                renderChart(data);
            } catch (err) {
                console.error("Error fetching simulation:", err);
            }
        }

        function renderChart(data) {
            const traceCurrent = { x: [0], y: [data.current_price], mode: 'markers', name: 'Current Price', marker: { size: 12, color: '#ffffff' } };
            const trace95 = { x: [0, 252], y: [data.current_price, data.percentile_95], mode: 'lines', name: '95% Bull Case', line: { color: '#00ff88', width: 2 } };
            const traceMean = { x: [0, 252], y: [data.current_price, data.mean_expected_price], mode: 'lines', name: 'Mean Path', line: { color: '#00f2fe', width: 3 } };
            const trace5 = { x: [0, 252], y: [data.current_price, data.percentile_5], mode: 'lines', name: '5% Bear Case', line: { color: '#ff0055', width: 2 } };

            const layout = {
                title: { text: '3D Monte Carlo Probability Cone', font: { color: '#ffffff' } },
                paper_bgcolor: '#0f172a',
                plot_bgcolor: '#0f172a',
                xaxis: { gridcolor: '#1e293b', title: 'Days Ahead' },
                yaxis: { gridcolor: '#1e293b', title: 'Price (USDT)' },
                legend: { font: { color: '#ffffff' } }
            };

            Plotly.newPlot('chart-container', [traceCurrent, trace95, traceMean, trace5], layout);
        }

        // تشغيل المحاكاة تلقائياً عند فتح الصفحة
        fetchSimulation();
    </script>
</body>
</html>
